{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/model/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/runtime/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
